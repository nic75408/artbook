{
  "name": "artbook",
  "version": "1.0.0",
  "description": "艺术手册 Artbook - 每日更新 30 幅艺术史杰作的私人画册 PWA",
  "private": true,
  "scripts": {
    "dev": "http-server -p 8888 -c-1",
    "test": "npm run test:unit && npm run test:playwright",
    "test:unit": "node tests/sw_prefetch_logic.test.mjs",
    "test:playwright": "node scripts/run-playwright.mjs",
    "test:feed": "node scripts/run-playwright.mjs tests/feed-alignment.spec.js --project=chromium",
    "test:aspect": "node scripts/run-playwright.mjs tests/artwork-aspect-ratio.spec.js --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "http-server": "^14.1.1"
  }
}
