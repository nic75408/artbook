      "movement_zh": "学院派",
      "tags": [
        "宗教题材",
        "19世纪",
        "英国",
        "学院派",
        "圣经故事",
        "肖像"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1986.74/1986.74_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1986.74/1986.74_print.jpg",
