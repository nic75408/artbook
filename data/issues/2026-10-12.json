      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1998.78.10/1998.78.10_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1998.78.10/1998.78.10_print.jpg",
