      "artist_zh": "梁楷",
      "artist_id": "liang-kai-chinese-mid-1100s-early-1200s",
      "artist_nationality_zh": "中国",
      "artist_years": "12 世纪末–13 世纪初",
      "date_display": "early 1200s",
