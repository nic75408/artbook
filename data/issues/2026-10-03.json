      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1962.169/1962.169_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1962.169/1962.169_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1962.169/1962.169_web.jpg",
        "ratio": 0.571
