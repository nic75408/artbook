      "title_en": "Ink Flowers",
      "title_zh": "水墨花卉图",
      "artist_en": "Zhao Zhong (Chinese, second half of the 1300s)",
      "artist_zh": "赵中",
      "artist_id": "zhao-zhong-chinese-second-half-of-the-1300s",
