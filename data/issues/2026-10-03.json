      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1960.184/1960.184_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1960.184/1960.184_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1960.184/1960.184_web.jpg",
