        "河流"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1915.691/1915.691_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1915.691/1915.691_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1915.691/1915.691_web.jpg",
        "ratio": 1.206
