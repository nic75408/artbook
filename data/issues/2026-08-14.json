      "image": {
        "feed": "https://images.metmuseum.org/CRDImages/ep/web-large/DT229079.jpg",
        "full": "https://images.metmuseum.org/CRDImages/ep/original/DT229079.jpg",
        "thumb": "https://images.metmuseum.org/CRDImages/ep/web-large/DT229079.jpg",
        "ratio": 1.357
