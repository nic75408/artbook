      "credit": "Cleveland Museum of Art, CC0",
      "title_en": "Haboku (Flung-ink) Landscape",
      "title_zh": "破墨山水图",
      "artist_en": "Shūgetsu Tōkan (Japanese, 1440?–1529)",
      "artist_zh": "周月东堪",
