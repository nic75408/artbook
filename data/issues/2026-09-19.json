      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1962.279.155.a/1962.279.155.a_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1962.279.155.a/1962.279.155.a_print.jpg",
