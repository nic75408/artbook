        "大象",
        "肖像"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/2018.140/2018.140_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/2018.140/2018.140_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/2018.140/2018.140_web.jpg",
        "ratio": 0.672
