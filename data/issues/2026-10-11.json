      "dimensions": "Painting: 104.5 x 42.2 cm (41 1/8 x 16 5/8 in.); Overall with knobs: 195.4 x 61.8 cm (76 15/16 x 24 5/16 in.)",
      "movement_zh": "宋代佛教绘画",
      "tags": [
        "宗教",
        "13世纪",
        "中国",
        "佛教",
        "白描",
        "观音"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1972.160/1972.160_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1972.160/1972.160_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1972.160/1972.160_web.jpg",
        "ratio": 2.479
