      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1958.25/1958.25_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1958.25/1958.25_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1958.25/1958.25_web.jpg",
        "ratio": 0.778
