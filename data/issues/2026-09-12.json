        "19世纪",
        "法国",
        "纳比派",
        "构图",
        "宗教仪式"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/2020.108/2020.108_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/2020.108/2020.108_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/2020.108/2020.108_web.jpg",
        "ratio": 1.216
