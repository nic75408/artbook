      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/2018.145/2018.145_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/2018.145/2018.145_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/2018.145/2018.145_web.jpg",
        "ratio": 0.889
