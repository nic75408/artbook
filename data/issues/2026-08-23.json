      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1955.37.1/1955.37.1_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1955.37.1/1955.37.1_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1955.37.1/1955.37.1_web.jpg",
        "ratio": 0.636
