      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/2018.146/2018.146_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/2018.146/2018.146_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/2018.146/2018.146_web.jpg",
        "ratio": 0.717
