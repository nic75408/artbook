        "荷兰",
        "水景",
        "巴黎郊区"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1993.236/1993.236_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1993.236/1993.236_print.jpg",
