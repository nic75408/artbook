      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1962.279.132.b/1962.279.132.b_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1962.279.132.b/1962.279.132.b_print.jpg",
