        "日本",
        "屏风",
        "水墨",
        "酒徒"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1976.11.1/1976.11.1_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1976.11.1/1976.11.1_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1976.11.1/1976.11.1_web.jpg",
        "ratio": 0.352
