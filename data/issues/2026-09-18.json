      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1987.162/1987.162_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1987.162/1987.162_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1987.162/1987.162_web.jpg",
        "ratio": 1.091
