      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1980.254.2/1980.254.2_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1980.254.2/1980.254.2_print.jpg",
