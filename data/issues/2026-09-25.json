      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1994.116.1/1994.116.1_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1994.116.1/1994.116.1_print.jpg",
