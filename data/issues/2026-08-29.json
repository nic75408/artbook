      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1915.687/1915.687_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1915.687/1915.687_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1915.687/1915.687_web.jpg",
        "ratio": 1.166
