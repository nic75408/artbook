      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1989.248/1989.248_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1989.248/1989.248_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1989.248/1989.248_web.jpg",
        "ratio": 0.764
