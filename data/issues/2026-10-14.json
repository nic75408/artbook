        "莫卧儿"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/2013.310/2013.310_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/2013.310/2013.310_print.jpg",
