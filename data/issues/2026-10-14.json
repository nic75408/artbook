        "死亡"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1916.806/1916.806_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1916.806/1916.806_print.jpg",
