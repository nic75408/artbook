        "耆那教"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1932.119.22.a/1932.119.22.a_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1932.119.22.a/1932.119.22.a_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1932.119.22.a/1932.119.22.a_web.jpg",
        "ratio": 0.446
