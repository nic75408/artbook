      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/2018.152/2018.152_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/2018.152/2018.152_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/2018.152/2018.152_web.jpg",
        "ratio": 0.858
