      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1932.119.42.a/1932.119.42.a_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1932.119.42.a/1932.119.42.a_print.jpg",
