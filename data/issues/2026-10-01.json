        "天空",
        "情绪"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1927.388/1927.388_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1927.388/1927.388_print.jpg",
