      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1931.440/1931.440_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1931.440/1931.440_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1931.440/1931.440_web.jpg",
