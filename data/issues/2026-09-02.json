      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1915.684/1915.684_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1915.684/1915.684_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1915.684/1915.684_web.jpg",
        "ratio": 0.643
