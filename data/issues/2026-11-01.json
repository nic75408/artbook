      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1942.2.13.b/1942.2.13.b_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1942.2.13.b/1942.2.13.b_print.jpg",
