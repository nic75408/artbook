      "image": {
        "feed": "https://images.metmuseum.org/CRDImages/ep/web-large/DP-42409-001.jpg",
        "full": "https://images.metmuseum.org/CRDImages/ep/original/DP-42409-001.jpg",
        "thumb": "https://images.metmuseum.org/CRDImages/ep/web-large/DP-42409-001.jpg",
        "ratio": 1.371
