      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1964.371.2/1964.371.2_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1964.371.2/1964.371.2_print.jpg",
