        "女性",
        "服饰"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1977.117/1977.117_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1977.117/1977.117_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1977.117/1977.117_web.jpg",
        "ratio": 1.199
