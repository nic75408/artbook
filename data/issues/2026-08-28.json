        "feed": "https://openaccess-cdn.clevelandart.org/1964.282/1964.282_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1964.282/1964.282_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1964.282/1964.282_web.jpg",
        "ratio": 0.681
      },
      "palette": [
        "#b4af98",
