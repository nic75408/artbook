      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1932.119.45.b/1932.119.45.b_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1932.119.45.b/1932.119.45.b_print.jpg",
