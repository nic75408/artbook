        "威尼斯画派",
        "圣经题材"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1952.235.4/1952.235.4_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1952.235.4/1952.235.4_print.jpg",
