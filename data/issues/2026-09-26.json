        "中国",
        "明代",
        "绢本"
      ],
      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1979.27.2.15/1979.27.2.15_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1979.27.2.15/1979.27.2.15_print.jpg",
