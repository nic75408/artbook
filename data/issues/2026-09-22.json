      "image": {
        "feed": "https://openaccess-cdn.clevelandart.org/1966.29/1966.29_web.jpg",
        "full": "https://openaccess-cdn.clevelandart.org/1966.29/1966.29_print.jpg",
        "thumb": "https://openaccess-cdn.clevelandart.org/1966.29/1966.29_web.jpg",
        "ratio": 1.42
